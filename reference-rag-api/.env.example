# Copy this file to .env and fill in real values. Never commit .env.

# --- Gemini (get a free key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# Check https://ai.google.dev/gemini-api/docs/models in AI Studio before
# deploying -- Google renames/retires free-tier model IDs periodically.
# These are the only lines you should need to touch if that happens.
TEXT_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash
AUDIO_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
# gemini-embedding-001 defaults to 3072 dims; truncated to 768 here to keep
# each stored row small (Supabase free tier is 500MB). Must match the
# vector(N) column created in app/rag/db.py if you change it.
EMBED_DIM=768

# Tool, not a personality. Keep this low (0.2-0.5 per spec).
TEMPERATURE=0.3

# --- RAG behavior ---
RAG_KEYWORD=REFERENCE BOOK:
DEFAULT_COLLECTION=default_reference
TOP_K=5
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40
MAX_RELEVANT_DISTANCE=0.9
# Chunks are embedded+stored in batches of this size while ingesting a PDF --
# this, not the PDF's page count, is what bounds ingest memory use. Kept
# small on purpose for a 512MB host; raising it mainly trades a bit more
# memory for fewer, bigger Postgres round-trips.
INGEST_BATCH_SIZE=24
# DPI for rendering a page that has an embedded image (for /vision/page).
# 110 is legible for diagrams/charts without print-quality overhead --
# matters most on image-heavy slideshow PDFs where most pages render one.
PAGE_IMAGE_DPI=110

# --- Persistent storage: Supabase Postgres + pgvector (free, no card) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (URI). Use "Session pooler" mode -- built for exactly this short-lived,
# many-cold-starts usage pattern. See README "Supabase setup".
DATABASE_URL=
# Kept small -- this app runs as a single uvicorn worker, and every pooled
# connection has its own (small but nonzero) memory cost.
DB_POOL_MAX_SIZE=3

# Scratch space only, while a request is being processed (e.g. streaming a
# large PDF upload to disk in chunks instead of holding it all in RAM).
# Nothing durable is ever kept here. Default sized for the actual intended
# content -- novels/textbooks and short slideshows, not arbitrary giant
# scans -- raise it if you genuinely need more.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=150
UPLOAD_STREAM_CHUNK_BYTES=1048576

# --- API auth: pick a real random string, this gates every endpoint ---
API_KEY=changeme
# Optional -- if left blank, security.py derives one from API_KEY so
# session tokens work with zero extra config. Set your own random string
# for extra hygiene.
SESSION_SECRET=
# How long a browser-widget session token stays valid before that tab has
# to re-enter the real API_KEY once. The widget never stores the real key
# itself, only this short-lived token -- see app/security.py.
SESSION_TTL_HOURS=24

# Comma-separated. Use * only while testing locally -- lock this down to
# your actual widget's origin(s) once deployed, it's a real layer of
# defense alongside the session-token change above.
CORS_ORIGINS=*

# --- Email delivery (Gmail app password is the free path -- see README) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Privacy ---
PRIVACY_SAFE_LOGGING=true
